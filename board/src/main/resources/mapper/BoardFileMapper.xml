<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.board.mapper.BoardFileMapper">
    <insert id="insertBoardFile">
        <!--게시글 파일 정보 저장(file_idx·del_yn·reg_dttm은 DB 기본값)-->
        insert into board_file (
         board_idx
         ,file_original_name
         ,file_save_name
         ,file_size
        ) values (
         #{boardIdx}
         ,#{fileOriginalName}
         ,#{fileSaveName}
         ,#{fileSize}
        )
    </insert>

</mapper>